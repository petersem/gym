{
  "name": "gym",
  "version": "1.0.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm run devall --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --reporters=default",
    "test:coverage": "npm test -- --coverage --verbose",
    "testfile": "npm run test -- --verbose --coverage > test_results.txt 2>&1",
    "doc": "jsdoc -c jsdoc.conf.json",
    "lint": "eslint .",
    "prettier:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "overrides": {
    "deepmerge": "4.1.1",
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "@parcel/watcher@2.6.0": true,
    "@scarf/scarf@1.4.0": true,
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true,
    "bson@0.2.22": true,
    "kerberos@0.0.4": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@jest/globals": "^30.5.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "express-openapi-validator": "^5.6.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "swagger-jsdoc": "^6.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
