{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i src/public/css/style.css -o src/dist/css/tailwind.css",
    "dev": "npm run build:css && nodemon --no-stdin --watch src --watch .env --ext ejs,js,mjs,env --ignore src/dist --env-file=.env src/scripts/startServer.mjs development",
    "prod": "npm run build:css && node --env-file=.env src/scripts/startServer.mjs production",
    "tailwind": "npx @tailwindcss/cli -i src/public/css/style.css -o src/dist/css/tailwind.css --watch",
    "dbcreate": "node --env-file=.env src/scripts/initializeDatabase.mjs",
    "devfull": "npm-run-all --parallel dbcreate dev tailwind",
    "doc": "npm --prefix .. run doc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "daisyui": "^5.7.47",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-rate-limiter": "^1.3.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "fast-xml-builder": "^1.3.1",
    "mysql2": "^3.24.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "nodemon": "^3.1.14"
  }
}
