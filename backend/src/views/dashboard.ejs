<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>Gym Dashboard</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role, authenticatedUser }) %>

        <section class="dashboard-intro" aria-labelledby="dashboard-title">
            <h2 id="dashboard-title">Dashboard</h2>
            <p>
                <% if (authenticatedUser) { %>
                    Welcome back, <%= authenticatedUser.first_name %>.
                <% } else { %>
                    Welcome to the gym management portal.
                <% } %>
            </p>

            <div class="dashboard-links">
                <% if (authenticatedUser) { %>
                    <a class="btn btn-primary" href="/authenticate/logout">Log out</a>
                <% } else { %>
                    <a class="btn btn-primary" href="/authenticate">Log in</a>
                    <a class="btn btn-secondary" href="/authenticate/register">Register</a>
                <% } %>
                <a class="btn btn-outline" href="/api-docs">API documentation</a>
            </div>
        </section>

        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>