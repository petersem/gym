<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>Activity Management - Gym</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role, authenticatedUser }) %>

        <section>
            <h2>Activities</h2>
            <div class="list-search">
                <label for="activity-search">Search activities</label>
                <div class="list-search-control">
                    <input id="activity-search" type="search" value="<%= selectedSearchTerm %>" onkeydown="if (event.key === 'Enter') { event.preventDefault(); filterActivities(); }">
                    <button type="button" class="btn-accent" onclick="filterActivities()">Search</button>
                </div>
            </div>
            <div class="list-results">
                <table class="list-results-table">
                    <% const activitySortLink = (column) => {
                        const params = new URLSearchParams();
                        if (selectedSearchTerm) params.set('search_term', selectedSearchTerm);
                        params.set('sort_by', column);
                        params.set('sort_dir', selectedSortBy === column && selectedSortDir === 'asc' ? 'desc' : 'asc');
                        return `/activities?${params.toString()}`;
                    }; %>
                    <% const activitySortAria = (column) => selectedSortBy === column
                        ? (selectedSortDir === 'asc' ? 'ascending' : 'descending')
                        : 'none'; %>
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="<%= activitySortAria('name') %>"><a class="sort-link" href="<%= activitySortLink('name') %>" aria-label="Sort by name">Name</a></th>
                            <th scope="col" aria-sort="<%= activitySortAria('description') %>"><a class="sort-link" href="<%= activitySortLink('description') %>" aria-label="Sort by description">Description</a></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (activities.length === 0) { %>
                            <tr><td colspan="2">No activities match this search.</td></tr>
                        <% } %>
                        <% activities.forEach((activity) => { %>
                            <tr>
                                <td><a href="/activities/<%= activity.id %>#activity-management"><%= activity.name %></a></td>
                                <td><%= activity.description %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% if (totalPages > 1) { %>
                <% const activityPageLink = (page) => {
                    const params = new URLSearchParams();
                    if (selectedSearchTerm) params.set('search_term', selectedSearchTerm);
                    params.set('sort_by', selectedSortBy);
                    params.set('sort_dir', selectedSortDir);
                    params.set('page', page);
                    return `/activities?${params.toString()}`;
                }; %>
                <nav class="pagination" aria-label="Activities pagination">
                    <a class="btn-outline<%= selectedPage <= 1 ? ' is-disabled' : '' %>" href="<%= selectedPage > 1 ? activityPageLink(selectedPage - 1) : '#' %>" aria-disabled="<%= selectedPage <= 1 %>">Previous</a>
                    <span>Page <%= selectedPage %> of <%= totalPages %></span>
                    <a class="btn-outline<%= selectedPage >= totalPages ? ' is-disabled' : '' %>" href="<%= selectedPage < totalPages ? activityPageLink(selectedPage + 1) : '#' %>" aria-disabled="<%= selectedPage >= totalPages %>">Next</a>
                </nav>
            <% } %>
        </section>

        <script>
            function filterActivities() {
                const params = new URLSearchParams(window.location.search);
                const searchTerm = document.getElementById('activity-search').value.trim();
                if (searchTerm) params.set('search_term', searchTerm); else params.delete('search_term');
                params.delete('page');
                window.location.href = `/activities${params.toString() ? `?${params}` : ''}`;
            }
        </script>

        <section id="activity-management">
            <h2>Activity management - <%= selectedActivity.id ? 'Edit' : 'Create' %></h2>
            <form action="/activities<%= selectedActivity.id ? '/' + selectedActivity.id : '' %>" method="post" class="form-grid responsive-half">
                <label for="name">Name</label>
                <input id="name" name="name" value="<%= selectedActivity.name %>" required>

                <label for="description">Description</label>
                <textarea id="description" name="description" required><%= selectedActivity.description %></textarea>

                <input type="hidden" name="updatedBy" value="<%= authenticatedUser.id ?? 0 %>">
                <button type="submit" name="action" value="<%= selectedActivity.id ? 'update' : 'create' %>">
                    <%= selectedActivity.id ? 'Update activity' : 'Create activity' %>
                </button>

                <% if (selectedActivity.id) { %>
                    <button type="button" onclick="window.location.href='/activities#activity-management'">Clear</button>
                    <button type="submit" name="action" value="delete">Delete activity</button>
                <% } %>
            </form>
        </section>

        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>