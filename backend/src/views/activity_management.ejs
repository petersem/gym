<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>Activity Management - Gym</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role, authenticatedUser }) %>

        <section>
            <h2>Activities</h2>
            <ul>
                <% activities.forEach((activity) => { %>
                    <li>
                        <a href="/activities/<%= activity.id %>"><%= activity.name %></a>
                        <% if (activity.description) { %>
                            <p><%= activity.description %></p>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        </section>

        <section>
            <h2>Activity management</h2>
            <form action="/activities<%= selectedActivity.id ? '/' + selectedActivity.id : '' %>" method="post" class="form-grid responsive-half">
                <label for="name">Name</label>
                <input id="name" name="name" value="<%= selectedActivity.name %>" required>

                <label for="description">Description</label>
                <textarea id="description" name="description" required><%= selectedActivity.description %></textarea>

                <input type="hidden" name="updatedBy" value="<%= authenticatedUser.id ?? 0 %>">
                <button type="submit" name="action" value="<%= selectedActivity.id ? 'update' : 'create' %>">
                    <%= selectedActivity.id ? 'Update activity' : 'Create activity' %>
                </button>

                <% if (selectedActivity.id) { %>
                    <button type="button" onclick="window.location.href='/activities'">Clear</button>
                    <button type="submit" name="action" value="delete">Delete activity</button>
                <% } %>
            </form>
        </section>

        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>