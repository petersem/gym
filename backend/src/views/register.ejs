<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>Gym - Create account</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role: "", authenticatedUser: undefined }) %>
        <section>
            <h2>Register</h2>
            <form action="/authenticate/register" method="post" novalidate class="form-grid responsive-half margin-auto">
                <%- include("partials/form-errors.ejs", { fields: ['firstName', 'lastName', 'email', 'password', 'phone', 'dob'] }) %>
                <p class="two-col">* Required fields</p>
                <%- include("partials/form-field.ejs", { field: 'firstName', id: 'first-name', label: 'First name', requiredField: true }) %>
                <%- include("partials/form-field.ejs", { field: 'lastName', id: 'last-name', label: 'Last name', requiredField: true }) %>
                <%- include("partials/form-field.ejs", { field: 'email', id: 'email', label: 'Email', requiredField: true, type: 'email', placeholder: 'e.g. alex@example.com' }) %>
                <%- include("partials/form-field.ejs", { field: 'password', id: 'password', label: 'Password', requiredField: true, type: 'password' }) %>
                <%- include("partials/form-field.ejs", { field: 'phone', id: 'phone', label: 'Phone', requiredField: true, type: 'tel', placeholder: 'e.g. 0412 345 678' }) %>
                <%- include("partials/form-field.ejs", { field: 'dob', id: 'dob', label: 'Date of birth', type: 'date' }) %>

                <input type="submit" value="Register" class="register-submit">
                <a href="/authenticate" class="link-button">Back to login</a>
            </form>
        </section>
        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>