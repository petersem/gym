<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
        <title><%= pageTitle %> - Gym</title>
</head>

<body>
    <% const formatSessionDateTime=(date, time)=> new Intl.DateTimeFormat('en-AU', {
        day: '2-digit', month: '2-digit', year: 'numeric',
        hour: 'numeric', minute: '2-digit', hour12: true,
        }).format(new Date(`${String(date).slice(0, 10)}T${time}`)).replace(/\s+(am|pm)$/i, '$1'); %>
        <% const formatSessionTime=(time)=> { const [hour, minute] = String(time).slice(0, 5).split(':').map(Number);
            return `${hour % 12 || 12}:${String(minute).padStart(2, '0')}${hour >= 12 ? 'pm' : 'am'}`; }; %>
            <% const getSessionHoverText=(session)=> {
                const activity = activities.find((item) => Number(item.id) === Number(session.activity_id));
                return [
                activity?.name ?? 'Unknown activity',
                activity?.description ?? 'No description available',
                ].join(String.fromCharCode(10));
                }; %>
                <% const sortedLocations=[...locations].sort((a, b)=> a.name.localeCompare(b.name)); %>
                <% const sortedTrainers=[...users].filter((user)=> user.role === 'trainer').sort((a, b) =>
                    a.last_name.localeCompare(b.last_name) || a.first_name.localeCompare(b.first_name)); %>
                <% const availableFilterQuery=new URLSearchParams({
                    ...(availableLocationId ? { available_location_id: availableLocationId } : {}),
                    ...(availableTrainerId ? { available_trainer_id: availableTrainerId } : {})
                }).toString(); %>
                    <% const bookingFilterQuery=new URLSearchParams({ booking_trainer_id: String(bookingTrainerId ?? 'all' ),
                        booking_location_id: String(bookingLocationId ?? '') }).toString(); %>
                        <% const xmlExportQuery=new URLSearchParams({ booking_user_id: String(bookingUserId ?? '' ),
                            booking_trainer_id: String(bookingTrainerId ?? '' ), booking_location_id:
                            String(bookingLocationId ?? '' ) }).toString(); %>
                            <main>
                                <%- include("partials/header.ejs") %>
                                    <%- include("partials/nav.ejs", { role, authenticatedUser }) %>

                                        <% if (typeof hasFormFeedback !== 'undefined' && hasFormFeedback && authenticatedUser?.role === 'member') { %>
                                            <section id="booking-validation">
                                                <h2>Correct booking submission</h2>
                                                <form action="<%= formDestination %>" method="post" novalidate class="form-grid responsive-half">
                                                    <%- include("partials/form-errors.ejs", { fields: ['sessionId', 'userId'] }) %>
                                                    <p class="two-col">* Required fields</p>
                                                    <%- include("partials/form-field.ejs", { field: 'sessionId', id: 'booking-session-id', label: 'Session', requiredField: true, type: 'select', options: sessions.map((session) => ({ value: session.id, label: session.title })) }) %>
                                                    <%- include("partials/form-field.ejs", { field: 'userId', id: 'booking-user-id', label: 'User', requiredField: true, type: 'select', options: (canManageBookings ? users : [authenticatedUser]).map((user) => ({ value: user.id, label: `${user.last_name}, ${user.first_name}` })) }) %>
                                                    <button type="submit" name="action" value="<%= formAction %>">Retry booking</button>
                                                </form>
                                            </section>
                                        <% } %>

                                        <% if (showAvailableSessions) { %>
                                        <section class="available-sessions-section">
                                            <div class="section-heading-row<%= authenticatedUser?.role === 'member' ? ' timetable-booking-heading' : '' %>">
                                                <h2>Available sessions next 7 days</h2>
                                                <% if (authenticatedUser && bookingCreated) { %>
                                                    <div class="alert-stack">
                                                        <div class="alert alert-brand fade-out-alert" role="status">
                                                            Booking added.
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <% if (authenticatedUser?.role === 'member') { %>
                                                <p class="timetable-booking-hint">Click a session to book</p>
                                            <% } %>
                                            <div class="timetable-filter-controls">
                                            <label for="available-location-filter">Location</label>
                                            <select id="available-location-filter"
                                                onchange="filterBookings('available_location_id', this.value)">
                                                <option value="">All locations</option>
                                                <% sortedLocations.forEach((location)=> { %>
                                                    <option value="<%= location.id %>"
                                                        <%=availableLocationId===location.id ? 'selected' : '' %>><%=
                                                            location.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <label for="available-trainer-filter">Trainer</label>
                                            <select id="available-trainer-filter"
                                                onchange="filterBookings('available_trainer_id', this.value)">
                                                <option value="all" <%=availableTrainerId ? '' : 'selected' %>>All</option>
                                                <% sortedTrainers.forEach((trainer)=> { %>
                                                    <option value="<%= trainer.id %>"
                                                        <%=availableTrainerId===Number(trainer.id) ? 'selected' : '' %>><%= trainer.last_name %>, <%= trainer.first_name %></option>
                                                <% }) %>
                                            </select>
                                            </div>
                                            <div class="session-calendar available-sessions-calendar">
                                                <% calendarDays.forEach((day)=> { %>
                                                    <article class="session-day card bg-base-100">
                                                        <h3>
                                                            <%= day.label %>
                                                        </h3>
                                                        <% if (day.sessions.length===0) { %>
                                                            <p>No sessions</p>
                                                            <% } else { %>
                                                                <ul>
                                                                    <% day.sessions.forEach((session)=> { %>
                                                                        <li class="available-session">
                                                                            <% const
                                                                                sessionLocation=locations.find((location)=>
                                                                                Number(location.id) ===
                                                                                Number(session.location_id)); %>
                                                                                <% const sessionTrainer=users.find((user)=>
                                                                                    Number(user.id) === Number(session.trainer_id));
                                                                                    const sessionDetails=[
                                                                                        !availableLocationId && sessionLocation ? sessionLocation.name : '',
                                                                                        !availableTrainerId && sessionTrainer ? `${sessionTrainer.first_name} ${sessionTrainer.last_name}` : ''
                                                                                    ].filter(Boolean);
                                                                                    const locationSuffix=sessionDetails.join(', '); %>
                                                                                    <% if (authenticatedUser?.role === 'member') { %>
                                                                                        <button type="button"
                                                                                            class="available-session-select"
                                                                                            title="<%= getSessionHoverText(session) %>">
                                                                                            <%= formatSessionTime(session.time)
                                                                                                %>
                                                                                                <%= session.title %>
                                                                                                    <span class="session-details"><%= locationSuffix %></span>
                                                                                        </button>
                                                                                        <form class="session-book-form"
                                                                                            action="/timetable<%= availableFilterQuery ? '?' + availableFilterQuery : '' %>"
                                                                                            method="post" novalidate>
                                                                                            <input type="hidden"
                                                                                                name="sessionId"
                                                                                                value="<%= session.id %>">
                                                                                            <input type="hidden"
                                                                                                name="userId"
                                                                                                value="<%= authenticatedUser?.id ?? (users[0]?.id || '') %>">
                                                                                            <button
                                                                                                class="btn btn-primary session-book-button"
                                                                                                type="submit"
                                                                                                name="action"
                                                                                                value="create"
                                                                                                hidden>Book</button>
                                                                                        </form>
                                                                                        <% } else { %>
                                                                                            <span
                                                                                                class="available-session-label"
                                                                                                title="<%= getSessionHoverText(session) %>">
                                                                                                <%= formatSessionTime(session.time)
                                                                                                    %>
                                                                                                    <%= session.title %>
                                                                                                        <span class="session-details"><%= locationSuffix %></span>
                                                                                            </span>
                                                                                            <% } %>
                                                                        </li>
                                                                        <% }) %>
                                                                </ul>
                                                                <% } %>
                                                    </article>
                                                    <% }) %>
                                            </div>
                                        </section>
                                        <% } %>

                                        <% if (showBookings && authenticatedUser) { %>
                                            <section id="bookings-next-7-days">
                                                <div class="section-heading-row">
                                                    <h2>Bookings next 7 days</h2>
                                                    <div class="alert-stack">
                                                        <% if (bookingCreated) { %>
                                                            <div class="alert alert-brand fade-out-alert" role="status">Booking added.</div>
                                                        <% } %>
                                                        <% if (bookingDeleted) { %>
                                                            <div class="alert alert-error fade-out-alert" role="status">Booking deleted.</div>
                                                        <% } %>
                                                    </div>
                                                    <a class="btn"
                                                        href="/bookings/export.xml?<%= xmlExportQuery %>">Download
                                                        </a>
                                                </div>
                                                <label for="booking-location-filter">Booked session location</label>
                                                <select id="booking-location-filter"
                                                    onchange="filterBookings('booking_location_id', this.value)">
                                                    <option value="">All locations</option>
                                                    <% sortedLocations.forEach((location)=> { %>
                                                        <option value="<%= location.id %>"
                                                            <%=bookingLocationId===location.id ? 'selected' : '' %>><%=
                                                                location.name %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                                <% if (canManageBookings) { %>
                                                                <label for="booking-trainer-filter">Booked
                                                                    trainer</label>
                                                                <select id="booking-trainer-filter"
                                                                    onchange="filterBookings('booking_trainer_id', this.value)">
                                                                    <option value="all" <%=bookingTrainerId ? ''
                                                                        : 'selected' %>>All trainers</option>
                                                                    <% sortedTrainers.forEach((trainer)=> { %>
                                                                        <option value="<%= trainer.id %>"
                                                                            <%=Number(bookingTrainerId)===Number(trainer.id)
                                                                            ? 'selected' : '' %>>
                                                                            <%= trainer.last_name %>, <%=
                                                                                    trainer.first_name %>
                                                                        </option>
                                                                        <% }) %>

                                                                </select>
                                                                    <% } %>
                                                                        <div class="session-calendar bookings-days-calendar">
                                                                            <% bookingCalendarDays.forEach((day)=> { %>
                                                                                <article
                                                                                    class="session-day card bg-base-100">
                                                                                    <h3>
                                                                                        <%= day.label %>
                                                                                    </h3>
                                                                                    <% if (day.bookings.length===0) { %>
                                                                                        <p>No bookings</p>
                                                                                        <% } else { %>
                                                                                            <ul>
                                                                                                <%
                                                                                                    day.bookings.forEach((booking)=>
                                                                                                    { %>
                                                                                                    <% const
                                                                                                        bookingSession=day.sessions.find((session)=>
                                                                                                        session.id
                                                                                                        ===
                                                                                                        Number(booking.session_id));
                                                                                                        %>
                                                                                                        <% const
                                                                                                            bookingUser=users.find((user)=>
                                                                                                            Number(user.id)
                                                                                                            ===
                                                                                                            Number(booking.user_id));
                                                                                                            %>
                                                                                                            <li>
                                                                                                                <% const canDeleteThisBooking = canDeleteBooking(booking, bookingSession); %>
                                                                                                                <% if (canDeleteThisBooking) { %>
                                                                                                                <a href="/bookings/<%= booking.id %><%= canManageBookings ? '?' + bookingFilterQuery : '' %>#bookings-next-7-days"
                                                                                                                    title="<%= bookingSession ? getSessionHoverText(bookingSession) : 'Session details unavailable' %>">
                                                                                                                <% } else { %>
                                                                                                                <span title="<%= bookingSession ? getSessionHoverText(bookingSession) : 'Session details unavailable' %>">
                                                                                                                <% } %>
                                                                                                                    <%= bookingSession
                                                                                                                        ?
                                                                                                                        formatSessionTime(bookingSession.time)
                                                                                                                        : ''
                                                                                                                        %>
                                                                                                                        <%= bookingSession
                                                                                                                            ?
                                                                                                                            bookingSession.title
                                                                                                                            :
                                                                                                                            `Booking
                                                                                                                            #${booking.id}`
                                                                                                                            %>
                                                                                                                            <% if
                                                                                                                                (canManageBookings
                                                                                                                                &&
                                                                                                                                (authenticatedUser?.role==='trainer'
                                                                                                                                ||
                                                                                                                                authenticatedUser?.role==='admin'
                                                                                                                                )
                                                                                                                                &&
                                                                                                                                bookingUserId===null)
                                                                                                                                {
                                                                                                                                %>
                                                                                                                                (<%= bookingUser
                                                                                                                                    ?
                                                                                                                                    `${bookingUser.last_name},
                                                                                                                                    ${bookingUser.first_name}`
                                                                                                                                    : 'Unknown user'
                                                                                                                                    %>)
                                                                                                                                    <% }
                                                                                                                                        %>
                                                                                                                <% if (canDeleteThisBooking) { %>
                                                                                                                </a>
                                                                                                                <% } else { %>
                                                                                                                </span>
                                                                                                                <% } %>
                                                                                                                <% if
                                                                                                                    (selectedBooking.id===booking.id && canDeleteThisBooking)
                                                                                                                    { %>
                                                                                                                    <form
                                                                                                                        action="/bookings/<%= booking.id %><%= canManageBookings ? '?' + bookingFilterQuery : '' %>"
                                                                                                                        method="post" novalidate>
                                                                                                                        <button
                                                                                                                            type="submit"
                                                                                                                            name="action"
                                                                                                                            value="delete">Delete
                                                                                                                            booking</button>
                                                                                                                    </form>
                                                                                                                    <% }
                                                                                                                        %>
                                                                                                            </li>
                                                                                                            <% }) %>
                                                                                            </ul>
                                                                                            <% } %>
                                                                                </article>
                                                                                <% }) %>
                                                                        </div>
                                            </section>
                                            <% } %>
                                            <% if (showBookings && !authenticatedUser) { %>
                                                <section id="bookings-next-7-days">
                                                    <h2>Bookings</h2>
                                                    <p>Please log in to view your bookings.</p>
                                                </section>
                                            <% } %>

                                                <script>
                                                    document.querySelectorAll(".available-session-select").forEach((sessionButton) => {
                                                        sessionButton.addEventListener("click", () => {
                                                            const selectedItem = sessionButton.closest(".available-session");
                                                            document.querySelectorAll(".available-session").forEach((item) => {
                                                                const isSelected = item === selectedItem;
                                                                item.classList.toggle("is-selected", isSelected);
                                                                item.querySelector(".session-book-button").hidden = !isSelected;
                                                            });
                                                        });
                                                    });

                                                    if (window.location.hash) {
                                                        const scrollTarget = document.querySelector(window.location.hash);
                                                        if (scrollTarget) {
                                                            window.addEventListener("load", () => scrollTarget.scrollIntoView());
                                                        }
                                                    }

                                                    function filterBookings(key, value) {
                                                        const params = new URLSearchParams(window.location.search);
                                                        if (value === 'all') params.set(key, 'all');
                                                        else if (value) params.set(key, value);
                                                        else params.delete(key);
                                                        params.delete('session_id');
                                                        params.delete('booking_user_id');
                                                        params.delete('booking_created');
                                                        params.delete('booking_deleted');
                                                        const bookingFilter = key.startsWith('booking_');
                                                        const url = `${bookingFilter ? '/bookings' : '/timetable'}${params.toString() ? `?${params}` : ''}`;
                                                        const targetSection = bookingFilter ? '#bookings-next-7-days' : '';
                                                        window.location.href = `${url}${targetSection}`;
                                                    }

                                                    document.querySelectorAll(".fade-out-alert").forEach((alert) => {
                                                        setTimeout(() => alert.classList.add("is-hidden"), 3000);
                                                    });
                                                </script>

                                                <%- include("partials/footer.ejs") %>
                            </main>
</body>

</html>