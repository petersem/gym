<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title><%= location.name %> - Minute Coffee</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role: role ?? "", authenticatedUser }) %>

        <article aria-labelledby="location-title">
            <a href="/locations">Back to locations</a>
            <h2 id="location-title"><%= location.name %></h2>
            <dl class="data-list">
                <dt class="data-list-heading">Address</dt>
                <dd>
                    <%= location.street %><br>
                    <%= location.city %> <%= location.postcode %>
                </dd>
                <dt class="data-list-heading">Phone</dt>
                <dd><%= location.phone %></dd>
                <dt class="data-list-heading">Email</dt>
                <dd><%= location.email %></dd>
            </dl>
        </article>

        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>
