<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>Location Management - Gym</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role, authenticatedUser }) %>

        <section>
            <h2>Locations</h2>
            <ul>
                <% locations.forEach((location) => { %>
                    <li><a href="/locations/<%= location.id %>"><%= location.name %></a></li>
                <% }) %>
            </ul>
        </section>

        <section>
            <h2>Location management</h2>
            <form action="/locations<%= selectedLocation.id ? '/' + selectedLocation.id : '' %>" method="post" class="form-grid responsive-half">
                <label for="name">Name</label>
                <input id="name" name="name" value="<%= selectedLocation.name %>" required>

                <label for="phone">Phone</label>
                <input id="phone" name="phone" value="<%= selectedLocation.phone %>" required>

                <label for="email">Email</label>
                <input id="email" name="email" type="email" value="<%= selectedLocation.email %>" required>

                <label for="street">Street</label>
                <input id="street" name="street" value="<%= selectedLocation.street %>" required>

                <label for="city">City</label>
                <input id="city" name="city" value="<%= selectedLocation.city %>" required>

                <label for="postcode">Postcode</label>
                <input id="postcode" name="postcode" type="number" value="<%= selectedLocation.postcode %>" required>

                <label for="manager">Manager</label>
                <select id="manager" name="manager" required>
                    <% users.forEach((user) => { %>
                        <option value="<%= user.id %>" <%= Number(selectedLocation.manager) === user.id ? 'selected' : '' %>>
                            <%= user.last_name %>, <%= user.first_name %>
                        </option>
                    <% }) %>
                </select>

                <p class="two-col">Updated by: <%= authenticatedUser.last_name ?? '' %>, <%= authenticatedUser.first_name ?? '' %></p>
                <button type="submit" name="action" value="<%= selectedLocation.id ? 'update' : 'create' %>">
                    <%= selectedLocation.id ? 'Update location' : 'Create location' %>
                </button>

                <% if (selectedLocation.id) { %>
                    <button type="button" onclick="window.location.href='/locations'">Clear</button>
                    <button type="submit" name="action" value="delete">Delete location</button>
                <% } %>
            </form>
        </section>

        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>