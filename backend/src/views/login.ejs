<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>Gym - Sign in</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role: "", authenticatedUser: undefined }) %>
        <section>
            <form action="/authenticate" method="post" class="form-grid responsive-half margin-auto">
                <label for="username">Username:</label>
                <input type="text" name="username" id="username" />
                <label for="password">Password:</label>
                <input type="password" name="password" id="password" />
                <a href="/" class="link-button">Back</a>
                <input type="submit" value="Login" />
            </form>
            <p class="margin-auto responsive-half">
                Need an account? <a href="/authenticate/register">Register here</a>
            </p>
        </section>
        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>