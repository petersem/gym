<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>Gym - Sign in</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role: "", authenticatedUser: undefined }) %>
        <section>
            <form action="/authenticate" method="post" novalidate class="form-grid responsive-half margin-auto">
                <%- include("partials/form-errors.ejs", { fields: ['username', 'password'] }) %>
                <p class="two-col">* Required fields</p>
                <%- include("partials/form-field.ejs", { field: 'username', id: 'username', label: 'Username:', requiredField: true }) %>
                <%- include("partials/form-field.ejs", { field: 'password', id: 'password', label: 'Password:', requiredField: true, type: 'password' }) %>
                <a href="/" class="link-button">Back</a>
                <input type="submit" value="Login" />
            </form>
            <p class="margin-auto responsive-half">
                Need an account? <a href="/authenticate/register">Register here</a>
            </p>
        </section>
        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>