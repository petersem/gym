<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>Locations - Gym</title>
</head>

<body>
    <main>
        <%- include("partials/header.ejs") %>
        <%- include("partials/nav.ejs", { role: role ?? "", authenticatedUser }) %>

        <section aria-labelledby="locations-title">
            <h2 id="locations-title">Gym locations</h2>
            <form action="/locations" method="get" class="search-form">
                <label for="search-term">Search locations</label>
                <input type="search" name="search_term" id="search-term" value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>">
                <label for="sort-by">Sort by</label>
                <select name="sort_by" id="sort-by" onchange="this.form.submit()">
                    <option value="name" <%= typeof selectedSortBy !== 'undefined' && selectedSortBy === 'name' ? 'selected' : '' %>>Name</option>
                    <option value="suburb" <%= typeof selectedSortBy !== 'undefined' && selectedSortBy === 'suburb' ? 'selected' : '' %>>Suburb</option>
                    <option value="postcode" <%= typeof selectedSortBy !== 'undefined' && selectedSortBy === 'postcode' ? 'selected' : '' %>>Postcode</option>
                </select>
                <select name="sort_dir" id="sort-dir" onchange="this.form.submit()">
                    <option value="asc" <%= typeof selectedSortDir === 'undefined' || selectedSortDir === 'asc' ? 'selected' : '' %>>Ascending</option>
                    <option value="desc" <%= typeof selectedSortDir !== 'undefined' && selectedSortDir === 'desc' ? 'selected' : '' %>>Descending</option>
                </select>
                <button type="submit">Search</button>
            </form>

            <% if (locations.length === 0) { %>
                <p>No locations matched your search.</p>
            <% } else { %>
                <div class="card-list">
                    <% locations.forEach((location) => { %>
                        <article class="card-tile card bg-base-100 shadow-sm">
                            <h3><%= location.name %></h3>
                            <p>
                                <%= location.street %><br>
                                <%= location.suburb %> <%= location.postcode %><br>
                                <%= location.phone %>
                            </p>
                            <a class="btn btn-outline" href="/locations/<%= location.id %>">View location</a>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <%- include("partials/footer.ejs") %>
    </main>
</body>

</html>
