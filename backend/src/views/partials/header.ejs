<header class="site-header">
    <nav class="mobile-menu" aria-label="Primary navigation">
        <details>
            <summary class="mobile-menu-toggle" aria-label="Navigation menu">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M3 6h18M3 12h18M3 18h18" />
                </svg>
            </summary>
            <ul class="menu site-menu">
                <%- include('nav-links.ejs') %>
            </ul>
        </details>
    </nav>
    <a class="brand" href="/" aria-label="Gym dashboard">
        <span class="brand-mark" aria-hidden="true">HSG</span>
        <span class="brand-copy">
            <h1>High Street Gym</h1>
            <small>Management portal</small>
        </span>
    </a>
    <span class="site-kicker">When you want results, fast!</span>
    <div class="user-controls">
        <% if (typeof authenticatedUser !== 'undefined' && authenticatedUser) { %>
            <span
                class="badge badge-neutral authenticated-user role-badge role-<%= authenticatedUser.role %>"
                title="<%= authenticatedUser.role %>"
                aria-label="<%= authenticatedUser.first_name + ' ' + authenticatedUser.last_name + ', ' + authenticatedUser.role %>">
                <%= authenticatedUser.first_name %> <%= authenticatedUser.last_name %>
            </span>
        <% } %>
        <label class="theme-toggle-control" for="theme-toggle" title="Switch between light and dark themes">
            <span>Light</span>
            <input class="toggle toggle-sm" id="theme-toggle" type="checkbox" aria-label="Use dark theme">
            <span>Dark</span>
        </label>
    </div>
    <script>
        const themeToggle = document.getElementById("theme-toggle");
        themeToggle.checked = document.documentElement.dataset.theme === "dark";
        themeToggle.addEventListener("change", () => {
            const theme = themeToggle.checked ? "dark" : "light";
            document.documentElement.dataset.theme = theme;
            themeToggle.setAttribute("aria-label", theme === "dark" ? "Use light theme" : "Use dark theme");
            try {
                window.localStorage.setItem("gym-theme", theme);
            } catch {}
        });
    </script>
</header>