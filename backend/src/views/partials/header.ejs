<header class="site-header">
    <a class="brand" href="/" aria-label="Gym dashboard">
        <span class="brand-mark" aria-hidden="true">G</span>
        <span class="brand-copy">
            <h1>Gym</h1>
            <small>Management portal</small>
        </span>
    </a>
    <span class="site-kicker">Training / Members / Locations</span>
    <% if (typeof authenticatedUser !== 'undefined' && authenticatedUser) { %>
        <span
            class="badge badge-neutral authenticated-user role-badge role-<%= authenticatedUser.role %>"
            title="<%= authenticatedUser.role %>"
            aria-label="<%= authenticatedUser.first_name + ' ' + authenticatedUser.last_name + ', ' + authenticatedUser.role %>">
            <%= authenticatedUser.first_name %> <%= authenticatedUser.last_name %>
        </span>
    <% } %>
</header>