<%#
  Validation summary shown at the top of a form after a failed submission.
  Locals:
    fields - field names that already show their own message, so they are not repeated.
  Errors without a matching field, such as an invalid action or record ID, are listed here.
  Loads formFeedback.js to scroll the summary into view.
%>
<% const allErrors = typeof formErrors !== 'undefined' ? formErrors : {}; %>
<% if (Object.keys(allErrors).length) { %>
    <div id="form-validation" class="form-errors two-col" role="alert" tabindex="-1">
        <p>Please correct the highlighted fields.</p>
        <% Object.entries(allErrors).filter(([field]) => !fields.includes(field)).forEach(([, message]) => { %>
            <p><%= message %></p>
        <% }) %>
    </div>
    <script src="/js/formFeedback.js" defer></script>
<% } %>
